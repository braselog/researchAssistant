# Research Assistant Environment Variables
# Copy this file to .env and fill in your values
# Do NOT commit .env to version control

# =============================================================================
# TRANSCRIPTION SETTINGS
# =============================================================================

# Whisper model size (default: small)
# Options: tiny, base, small, medium, large-v3, turbo
# 
# Model comparison for 45 min audio:
#   tiny     - ~15 min on CPU, ~1GB RAM, fastest but least accurate
#   base     - ~25 min on CPU, ~1GB RAM
#   small    - ~1 hour on CPU, ~2GB RAM, good balance (recommended)
#   medium   - ~2-3 hours on CPU, ~5GB RAM
#   large-v3 - ~4-6 hours on CPU, ~10GB RAM, best accuracy
#   turbo    - ~30 min on CPU, ~6GB RAM, English-optimized
#
WHISPER_MODEL=small

# Language code for transcription (default: auto-detect)
# Use ISO 639-1 codes: en, es, fr, de, ja, zh, ko, etc.
# Leave empty or unset for automatic language detection
# WHISPER_LANGUAGE=

# Compute type for Whisper inference (default: auto)
# Options: auto, int8, float16, float32
# - auto: Uses int8 on CPU, float16 on GPU
# - int8: Fastest on CPU, slightly lower accuracy
# - float16: Fast on GPU, good accuracy
# - float32: Slowest, highest precision
# WHISPER_COMPUTE_TYPE=auto

# =============================================================================
# SPEAKER DIARIZATION (Optional)
# =============================================================================

# HuggingFace token for pyannote speaker diarization models
# 
# To enable speaker diarization:
#   1. Create account at: https://huggingface.co/join
#   2. Accept model terms at: https://hf.co/pyannote/speaker-diarization-3.1
#   3. Accept model terms at: https://hf.co/pyannote/segmentation-3.0  
#   4. Create access token at: https://hf.co/settings/tokens
#   5. Paste token below
#
# Without this token, transcription will still work but without
# identifying different speakers in the transcript.
#
# HF_TOKEN=hf_your_token_here

# =============================================================================
# OPTIONAL: OLLAMA INTEGRATION (for local LLM summarization)
# =============================================================================

# If you want to use Ollama for meeting summarization instead of Copilot
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=qwen3:14b

# =============================================================================
# APPLE CALENDAR INTEGRATION (CalDAV)
# =============================================================================

# Your Apple ID email address
APPLE_ID_EMAIL=

# App-specific password for CalDAV access
# Generate at: https://appleid.apple.com (Sign-In and Security > App-Specific Passwords)
# Note: This is NOT your regular Apple ID password - requires 2FA enabled
APPLE_APP_PASSWORD=

# CalDAV endpoint (default for iCloud)
CALDAV_URL=https://caldav.icloud.com/

# Default calendars to query (comma-separated list)
# These calendars will be used when checking schedule and free time
# To see all available calendars: bash .ra/skills/calendar/scripts/calendar-cli.sh calendars
# DEFAULT_CALENDARS=Manchester,Family,Church

# Calendar for writing new events (single calendar name)
# When adding new research tasks/blocks, they will be added to this calendar
# Leave empty to use first available calendar
# DEFAULT_WRITE_CALENDAR=Manchester

# Default reminder time before event start (in minutes)
# Set to 0 for reminder at event start time
# DEFAULT_REMINDER_MINUTES=15

# =============================================================================
# CALENDAR REMOTE ACCESS (Optional)
# =============================================================================

# Project location: local (default) or remote
# - local: Run calendar commands directly on this machine
# - remote: Execute calendar commands via SSH to your local machine
# Set to 'remote' when working from a remote server but want to access
# your local machine's calendar
CALENDAR_PROJECT_LOCATION=local

# SSH host alias (from ~/.ssh/config)
# This is the Host name you defined in ~/.ssh/config
# Default: local-pc (configured by setup-ssh.sh)
CALENDAR_LOCAL_SSH_HOST=local-pc

# Local machine username
# Your username on the local machine with Calendar.app
CALENDAR_LOCAL_SSH_USER=

# Local machine IP address
# The IP address of your local machine on the network
CALENDAR_LOCAL_IP=

# Path to calendar-cli.sh on local machine
# Full path to the calendar-cli.sh script on your local machine
# Default: /Users/[username]/Documents/researchAssistant/.github/skills/calendar/scripts/calendar-cli.sh
CALENDAR_CLI_PATH=

# =============================================================================
# GITHUB PROJECT SYNC
# =============================================================================

# Your GitHub organization name (required for project sync)
# Find at: https://github.com/[YOUR-ORG-NAME]
# Example: ManchesterBioinference
GITHUB_ORG_NAME=

# GitHub project board number (required for project sync)
# Find in your project URL: https://github.com/orgs/[ORG]/projects/[NUMBER]
# Example: 2
GITHUB_PROJECT_NUM=

# Local file to sync with GitHub Projects (default: tasks.md)
# This file will be bidirectionally synced with your GitHub project board
GITHUB_TASKS_FILE=tasks.md