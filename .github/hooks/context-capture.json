{
  "hooks": {
    "UserPromptSubmit": [
      {
        "type": "command",
        "command": "python3 .github/scripts/capture_context.py user-prompt",
        "windows": "python .github/scripts/capture_context.py user-prompt",
        "cwd": ".",
        "timeout": 5
      }
    ],
    "PostToolUse": [
      {
        "type": "command",
        "command": "python3 .github/scripts/capture_context.py tool-result",
        "windows": "python .github/scripts/capture_context.py tool-result",
        "cwd": ".",
        "timeout": 5
      }
    ],
    "PreCompact": [
      {
        "type": "command",
        "command": "python3 .github/scripts/capture_context.py pre-compact",
        "windows": "python .github/scripts/capture_context.py pre-compact",
        "cwd": ".",
        "timeout": 5
      }
    ]
  }
}
